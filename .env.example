# 复制为 .env 后再改密码。.env 不会覆盖已经存在的环境变量。
ADDR=:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 最低 Redis 4.0，更高版本也可以。低于 4.0 会拒绝启动。
# 验收用的 Redis 4.0 在 6380：docker run -d --name hc-redis4 -p 6380:6379 redis:4.0 redis-server --appendonly yes --appendfsync everysec
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=hc

ASSET_DIR=data/assets
WEB_DIR=web/dist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 0 表示使用默认限额：加入每分钟 30，登录每分钟 10，写入每分钟 180。负数表示不限制。
JOIN_RATE_PER_MINUTE=0
LOGIN_RATE_PER_MINUTE=0
WRITE_RATE_PER_MINUTE=0
MAX_UPLOAD_BYTES=0
BCRYPT_COST=0
